# ============================================================
# openclaw_agent — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Google Gemini (transcription & video analysis) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro

# --- Douyin media fetching ---
DOUYIN_COOKIE_FILE=config/douyin_cookies.txt   # Put your Douyin cookies here
USE_REAL_DOUYIN=1

# --- Video generation: choose one provider ---

# MiniMax Hailuo (text-to-video)
USE_REAL_MINIMAX=1
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=MiniMax-Hailuo-02
MINIMAX_OUT_DIR=./data/uploads                  # Where generated videos are saved

# Seedance / ByteDance Ark (image-to-video)
# USE_REAL_SEEDANCE=1
# ARK_API_KEY=your_ark_api_key
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_MODEL=seedance-1-5-pro-251215
# SEEDANCE_OUT_DIR=./data/uploads
# SEEDANCE_MANIFEST_DIR=./data/manifests

# --- Gemini video analysis ---
USE_REAL_GEMINI=1

# --- Tag knowledge base (built offline by video-agent-system) ---
TAG_DB_PATH=./video-agent-system/tag_knowledge_db/data/tag_knowledge.db
TAG_FALLBACK_SCRIPT_PACK_PATH=../workspace-tag-matcher/data/script_packs.json

# --- Stats database ---
STATS_DB_PATH=./data/video_stats.db

# --- Server ---
SERVER_BASE_URL=http://localhost:8000
AGENT_SERVICE_BASE_URL=http://127.0.0.1:8000

# --- Feishu bot entry (optional) ---
FEISHU_BOT_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
# FEISHU_ENCRYPT_KEY=your_feishu_encrypt_key

# How the Feishu adapter hands tasks to OpenClaw.
# Default command appends the generated orchestrator prompt as the last argument.
OPENCLAW_ORCHESTRATOR_COMMAND=openclaw agents spawn orchestrator
OPENCLAW_RUNS_ROOT=~/.openclaw/runs
OPENCLAW_START_MODE=cli
# Optional. Leave empty to inherit the FastAPI process cwd.
# OPENCLAW_WORKDIR=/home/YOUR_USER/.openclaw
FEISHU_RESULT_WATCH_TIMEOUT_SEC=3600
FEISHU_RESULT_WATCH_INTERVAL_SEC=10

# --- Polling (optional tuning) ---
# POLL_INTERVAL_SEC=10
# MAX_WAIT_SEC=300
